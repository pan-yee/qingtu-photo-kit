# 使用此 AppID 对应的 AppSecret；仅在已有服务实际 AppID 完全相同时才可复用。
WX_APPID=wx2b68d0818781b66d
WX_SECRET=
PUBLIC_BASE_URL=https://www.ai-dreams.xyz/qingtu-api

# 各自独立生成，至少 32 字符；请仅写入服务器 .env。
JWT_SECRET=
MEDIA_SIGNING_SECRET=

# 与微信后台消息推送设置一致：Token 为 3-32 位英文/数字，AESKey 为 43 位。
CONTENT_SECURITY_CALLBACK_TOKEN=
CONTENT_SECURITY_CALLBACK_AES_KEY=

DB_HOST=mysql
DB_PORT=3306
DB_NAME=qingtu_photo
DB_USER=qingtu_photo
DB_PASS=
MYSQL_ROOT_PASSWORD=

# Nginx 对外提供 HTTPS；容器只监听宿主机 127.0.0.1:3001。
PORT=3001
# 可选：Docker Hub 不可用时使用 Docker Official Images 在 ECR Public 的分发地址。
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
