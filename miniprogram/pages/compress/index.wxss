.page-intro {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  padding: 14rpx 8rpx 34rpx;
}

.intro-index {
  margin-bottom: 12rpx;
  color: #2d7a5d;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.intro-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.23;
  letter-spacing: -1.5rpx;
  white-space: pre-line;
}

.intro-desc {
  margin-top: 18rpx;
  color: #747b74;
  font-size: 24rpx;
  line-height: 1.6;
}

.compress-workspace {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-card {
  padding: 28rpx;
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.result-kicker,
.result-size {
  display: block;
}

.result-kicker {
  color: #788078;
  font-size: 21rpx;
}

.result-size {
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 780;
  letter-spacing: -1rpx;
}

.saving-pill {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #e1f0e8;
  color: #176a4d;
  font-size: 22rpx;
  font-weight: 700;
}

.result-preview {
  min-height: 300rpx;
  border-radius: 22rpx;
}

.loading-text {
  color: #747b74;
  font-size: 24rpx;
}

.file-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  color: #8a8f89;
  font-size: 21rpx;
}

.preset-card {
  padding: 28rpx;
}

.preset-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preset-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 104rpx;
  border: 1rpx solid rgba(24, 33, 32, 0.1);
  border-radius: 20rpx;
  background: #f7f7f3;
}

.preset-item.active {
  border-color: #1d6b4f;
  background: #e8f1ec;
  box-shadow: inset 0 0 0 1rpx #1d6b4f;
}

.preset-label {
  color: #353d38;
  font-size: 26rpx;
  font-weight: 700;
}

.preset-note {
  margin-top: 3rpx;
  color: #929791;
  font-size: 19rpx;
}

.preset-item.active .preset-label,
.preset-item.active .preset-note {
  color: #1d6b4f;
}

.preset-hint {
  margin-top: 18rpx;
  color: #71786f;
  font-size: 22rpx;
}

.button-row {
  margin-top: 2rpx;
}

