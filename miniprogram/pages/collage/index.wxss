.page-intro {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  padding: 14rpx 8rpx 34rpx;
}

.intro-index {
  margin-bottom: 12rpx;
  color: #397297;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.intro-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.23;
  letter-spacing: -1.5rpx;
  white-space: pre-line;
}

.intro-desc {
  margin-top: 18rpx;
  color: #747b74;
  font-size: 24rpx;
  line-height: 1.6;
}

.collage-workspace {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.photo-picker-card,
.template-card,
.result-card {
  padding: 28rpx;
}

.picker-count {
  color: #90958f;
  font-size: 22rpx;
}

.text-action {
  padding: 8rpx 4rpx !important;
  color: #717871;
  font-size: 22rpx;
}

.thumbnail-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.thumbnail,
.thumbnail-add {
  position: relative;
  height: 132rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f0f1ec;
}

.thumbnail image {
  width: 100%;
  height: 100%;
}

.thumbnail-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(17, 24, 21, 0.76);
  color: #ffffff;
  font-size: 25rpx;
}

.thumbnail-index {
  position: absolute;
  bottom: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: 7rpx;
  background: rgba(17, 24, 21, 0.63);
  color: #ffffff;
  font-size: 17rpx;
}

.thumbnail-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx dashed #b8beb7;
  color: #7c847d;
  font-size: 18rpx;
}

.add-symbol {
  margin-bottom: 2rpx;
  font-size: 34rpx;
  font-weight: 300;
}

.template-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.template-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 13rpx 6rpx 12rpx;
  border: 1rpx solid rgba(24, 33, 32, 0.08);
  border-radius: 20rpx;
  background: #f8f8f4;
}

.template-item.active {
  border-color: #2e6e94;
  background: #edf4f8;
  box-shadow: inset 0 0 0 1rpx #2e6e94;
}

.template-glyph {
  position: relative;
  display: grid;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 8rpx;
  padding: 6rpx;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 4rpx;
  border-radius: 11rpx;
  background: #dfdfd8;
}

.glyph-block {
  border-radius: 3rpx;
  background: #7c8e96;
}

.glyph-hero .block-a {
  grid-column: 1 / 3;
}

.glyph-hero .block-c,
.glyph-hero .block-d {
  display: none;
}

.glyph-vertical .glyph-block {
  grid-column: 1 / 3;
}

.glyph-vertical .block-c,
.glyph-vertical .block-d {
  display: none;
}

.glyph-horizontal .glyph-block {
  grid-row: 1 / 3;
}

.glyph-horizontal .block-c,
.glyph-horizontal .block-d {
  display: none;
}

.template-item.active .glyph-block {
  background: #37799e;
}

.template-label {
  font-size: 23rpx;
  font-weight: 700;
}

.template-note {
  margin-top: 1rpx;
  color: #989d97;
  font-size: 17rpx;
}

.result-title-row {
  margin-bottom: 16rpx;
}

.collage-preview {
  min-height: 300rpx;
  border-radius: 20rpx;
  background-color: #e5e5df;
  background-image: none;
}

.button-row {
  margin-top: 2rpx;
}

