page {
  --ink: #182120;
  --muted: #707872;
  --paper: #f6f3ec;
  --card: #ffffff;
  --line: rgba(24, 33, 32, 0.09);
  --green: #1d6b4f;
  --coral: #f06b4f;
  --yellow: #f4c95d;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
image,
canvas,
slider {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  background: transparent;
  color: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 50rpx rgba(44, 55, 48, 0.07);
}

.section-title {
  margin: 0;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.muted {
  color: var(--muted);
}

.primary-button,
.secondary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.primary-button {
  background: var(--ink);
  color: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(24, 33, 32, 0.18);
}

.primary-button[disabled] {
  background: #b4b8b1;
  box-shadow: none;
  color: rgba(255, 255, 255, 0.8);
}

.secondary-button {
  background: #e7eee8;
  color: var(--green);
}

.ghost-button {
  height: 80rpx;
  border: 1rpx solid rgba(24, 33, 32, 0.13);
  background: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
}

.button-row {
  display: flex;
  gap: 18rpx;
}

.button-row > button {
  flex: 1;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(24, 33, 32, 0.1);
  border-radius: 999rpx;
  background: #ffffff;
  color: #68706a;
  font-size: 25rpx;
}

.chip.active {
  border-color: var(--ink);
  background: var(--ink);
  color: #ffffff;
}

.empty-upload {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 360rpx;
  padding: 42rpx;
  overflow: hidden;
  border: 2rpx dashed rgba(29, 107, 79, 0.28);
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fbfcf8, #edf3ec);
  text-align: center;
}

.empty-upload::before {
  position: absolute;
  top: -70rpx;
  right: -50rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(244, 201, 93, 0.22);
  content: "";
}

.upload-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  border-radius: 31rpx;
  background: var(--green);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 300;
  box-shadow: 0 14rpx 34rpx rgba(29, 107, 79, 0.2);
}

.upload-title {
  position: relative;
  font-size: 31rpx;
  font-weight: 700;
}

.upload-tip {
  position: relative;
  margin-top: 10rpx;
  color: #7a837c;
  font-size: 24rpx;
}

.preview-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 320rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background-color: #e7e6df;
  background-image:
    linear-gradient(45deg, #d9d8d1 25%, transparent 25%),
    linear-gradient(-45deg, #d9d8d1 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #d9d8d1 75%),
    linear-gradient(-45deg, transparent 75%, #d9d8d1 75%);
  background-position: 0 0, 0 18rpx, 18rpx -18rpx, -18rpx 0;
  background-size: 36rpx 36rpx;
}

.preview-image {
  display: block;
  width: 100%;
  height: auto;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 25rpx;
}

.toolbar button {
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  background: #f1f2ed;
  color: var(--ink);
  font-size: 25rpx;
}

.setting-group {
  padding: 30rpx 28rpx;
}

.setting-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 650;
}

.setting-value {
  color: var(--green);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

slider {
  margin: 0;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: #f0eee6;
  color: #6e726b;
  font-size: 24rpx;
  line-height: 1.65;
}

.notice-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--yellow);
}

.busy-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(20, 27, 25, 0.42);
  color: #ffffff;
  font-size: 27rpx;
  backdrop-filter: blur(7rpx);
}

.busy-spinner {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 20rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

