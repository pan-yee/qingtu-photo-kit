.page-intro {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  padding: 14rpx 8rpx 34rpx;
}

.intro-index {
  margin-bottom: 12rpx;
  color: #74558d;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.intro-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.23;
  letter-spacing: -1.5rpx;
  white-space: pre-line;
}

.intro-desc {
  margin-top: 18rpx;
  color: #747b74;
  font-size: 24rpx;
  line-height: 1.6;
}

.grid-workspace {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.grid-card {
  padding: 26rpx;
}

.grid-subtitle {
  margin-left: 8rpx;
  color: #999e98;
  font-size: 20rpx;
}

.text-action {
  padding: 8rpx 4rpx !important;
  color: #717871;
  font-size: 22rpx;
}

.nine-grid {
  display: grid;
  width: 100%;
  overflow: hidden;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rpx;
  border-radius: 16rpx;
  background: #f1f1ec;
}

.grid-cell {
  display: block;
  width: 100%;
  height: 210rpx;
  background: #e3e3dd;
}

.grid-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 100%;
  height: 638rpx;
  border-radius: 16rpx;
  background: #f1f1ec;
  color: #7d847e;
  font-size: 23rpx;
}

.placeholder-spinner {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid #d8dcd6;
  border-top-color: #70508b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.tips-card {
  display: flex;
  gap: 20rpx;
  padding: 25rpx 27rpx;
  border-radius: 24rpx;
  background: #ece7f0;
}

.tip-number {
  color: #7f6395;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.tip-copy {
  display: flex;
  flex-direction: column;
}

.tip-title {
  color: #4f355f;
  font-size: 25rpx;
  font-weight: 700;
}

.tip-desc {
  margin-top: 4rpx;
  color: #786b80;
  font-size: 21rpx;
  line-height: 1.55;
}

.button-row {
  margin-top: 2rpx;
}


.fit-card { padding: 24rpx; }
.fit-hint { display: block; margin-top: 16rpx; color: #747b74; font-size: 23rpx; line-height: 1.6; }
.grid-tile { position: relative; width: 100%; height: 0; padding-bottom: 100%; }
.grid-tile .grid-cell { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.cell-number { position: absolute; left: 8rpx; bottom: 8rpx; padding: 2rpx 10rpx; border-radius: 8rpx; color: white; background: rgba(0,0,0,.45); font-size: 22rpx; }

.grid-card .text-action { width: auto; margin: 0; }
