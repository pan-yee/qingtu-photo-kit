.privacy-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(17, 25, 22, 0.52);
  backdrop-filter: blur(8rpx);
}

.privacy-sheet {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 100%;
  padding: 38rpx 34rpx 30rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(16, 24, 20, 0.2);
}

.privacy-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #e2f0e8;
  color: #1d6b4f;
  font-size: 34rpx;
  font-weight: 800;
}

.privacy-title {
  color: #182120;
  font-size: 32rpx;
  font-weight: 750;
}

.privacy-copy {
  margin-top: 16rpx;
  color: #687069;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: left;
}

.privacy-link {
  margin-top: 12rpx;
  padding: 12rpx 8rpx;
  color: #1d6b4f;
  font-size: 23rpx;
}

.privacy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #182120;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.privacy-cancel {
  margin-top: 8rpx;
  padding: 12rpx 28rpx;
  color: #777e77;
  font-size: 23rpx;
}

.privacy-note {
  margin-top: 14rpx;
  color: #969b95;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}

